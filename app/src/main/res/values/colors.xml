    <color name="glass_fill_strong">#D10D0B20</color>
    <color name="glass_stroke">#29FFFFFF</color>
    <color name="glass_stroke_strong">#3DFFFFFF</color>
    <color name="glass_highlight">#22FFFFFF</color>
    <color name="glass_highlight_end">#00FFFFFF</color>
    <color name="glass_inner_glow">#146D5CE0</color>
    <color name="glass_bg">#14FFFFFF</color>
    <color name="glass_border">#26FFFFFF</color>
    <color name="glass_card_bg">#9E120E2A</color>
    <color name="glass_border_menu">#26FFFFFF</color>
    <color name="glass_card_bg_menu">#9E120E2A</color>

