<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- === NIKSEY · midnight glass palette ===
         Глубокий чёрный + тёмный индиго, приглушённый violet и teal.
         Имена сохранены, чтобы не править layouts; значения — новые. -->

    <!-- Base -->
    <color name="bg_gradient_top">#140E33</color>
    <color name="bg_gradient_bottom">#020206</color>
    <color name="background_dark">#040410</color>
    <color name="surface_dark">#0B0A1E</color>

    <!-- Frosted glass: полупрозрачная заливка, тонкая кромка, внутренний блик -->
