<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/GlassCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Аватарка с неоновым бордером -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/contact_photo"
                android:layout_width="59dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_person"
                app:civ_border_color="@color/accent_purple"
                app:civ_border_width="2.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Имя контакта -->
            <TextView
                android:id="@+id/contact_fullname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/chivo"
                android:textColor="@color/text_primary"
                android:textSize="16.5sp"
                app:layout_constraintStart_toEndOf="@id/contact_photo"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/example_contact_name" />

            <!-- Статус -->
            <TextView
                android:id="@+id/contact_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/chivo"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                app:layout_constraintStart_toEndOf="@id/contact_photo"
                app:layout_constraintTop_toBottomOf="@id/contact_fullname"
                tools:text="@string/example_status_online" />

            <!-- Галочка выбора -->
            <ImageView
                android:id="@+id/contact_checkmark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>