<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.screens.settings.SettingsFragment">

    <!-- Отступ снизу внутри контейнера: ScrollView не учитывает padding при прокрутке.
         120dp — высота плавающей панели вкладок + отступ. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="120dp">

        <!-- ===== Стеклянная карточка профиля ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- Аватар со свечением -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp">

                <View
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_avatar_glow" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/settings_user_photo"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:civ_border_color="@color/accent_cyan"
                    app:civ_border_width="2dp" />

                <!-- Кнопка смены фото -->
                <ImageView
                    android:id="@+id/settings_shange_photo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_bar"
                    android:contentDescription="@string/todo"
                    android:padding="8dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/text_primary" />

            </FrameLayout>

            <TextView
                android:id="@+id/settings_full_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/settings_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_user_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/settings_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_bio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/settings_phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ===== Список настроек ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_row"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <!-- Имя пользователя -->
            <LinearLayout
                android:id="@+id/settings_btn_change_username"
                style="@style/NikseySettingsRow">

                <FrameLayout style="@style/NikseySettingsChip">
                    <ImageView
                        style="@style/NikseySettingsChipIcon"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    style="@style/NikseySettingsRowTitle"
                    android:text="@string/change_username" />

                <ImageView
                    style="@style/NikseySettingsChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/NikseySettingsDivider" />

            <!-- О себе -->
            <LinearLayout
                android:id="@+id/settings_btn_change_bio"
                style="@style/NikseySettingsRow">

                <FrameLayout style="@style/NikseySettingsChip">
                    <ImageView
                        style="@style/NikseySettingsChipIcon"
                        android:src="@drawable/ic_edit"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    style="@style/NikseySettingsRowTitle"
                    android:text="@string/about_me" />

                <ImageView
                    style="@style/NikseySettingsChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/NikseySettingsDivider" />

            <!-- Номер телефона -->
            <LinearLayout
                android:id="@+id/settings_btn_change_number_phone"
                style="@style/NikseySettingsRow">

                <FrameLayout style="@style/NikseySettingsChip">
                    <ImageView
                        style="@style/NikseySettingsChipIcon"
                        android:src="@drawable/ic_phone"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    style="@style/NikseySettingsRowTitle"
                    android:text="@string/phone_number" />

                <ImageView
                    style="@style/NikseySettingsChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/NikseySettingsDivider" />

            <!-- Email -->
            <LinearLayout
                android:id="@+id/settings_btn_change_email"
                style="@style/NikseySettingsRow">

                <FrameLayout style="@style/NikseySettingsChip">
                    <ImageView
                        style="@style/NikseySettingsChipIcon"
                        android:src="@drawable/ic_email"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    style="@style/NikseySettingsRowTitle"
                    android:text="@string/email" />

                <ImageView
                    style="@style/NikseySettingsChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/NikseySettingsDivider" />

            <!-- Кэш медиа: размер и очистка (сообщения не затрагиваются) -->
            <LinearLayout
                android:id="@+id/settings_btn_clear_cache"
                style="@style/NikseySettingsRow">

                <FrameLayout style="@style/NikseySettingsChip">
                    <ImageView
                        style="@style/NikseySettingsChipIcon"
                        android:src="@drawable/img_delete"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/settings_cache_title"
                    style="@style/NikseySettingsRowTitle"
                    android:text="@string/clear_cache_title" />

                <ImageView
                    style="@style/NikseySettingsChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/NikseySettingsDivider" />

            <!-- О приложении -->
            <LinearLayout
                android:id="@+id/settings_btn_about"
                style="@style/NikseySettingsRow">

                <FrameLayout style="@style/NikseySettingsChip">
                    <ImageView
                        style="@style/NikseySettingsChipIcon"
                        android:src="@drawable/img_info"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    style="@style/NikseySettingsRowTitle"
                    android:text="@string/about_app" />

                <ImageView
                    style="@style/NikseySettingsChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
