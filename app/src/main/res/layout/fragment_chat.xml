<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_backdrop"
    android:fitsSystemWindows="true">

    <!-- TOOLBAR -->
    <include
        android:id="@+id/toolbar_info"
        layout="@layout/toolbar_info"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp" />

    <!-- СПИСОК СООБЩЕНИЙ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/chat_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycle_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="140dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Предупреждение: ключ безопасности собеседника изменился (сообщения приостановлены до подтверждения) -->
    <LinearLayout
        android:id="@+id/chat_identity_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_identity_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:text="@string/identity_changed_warning"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_identity_accept"
            style="@style/NikseyButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="44dp"
            android:text="@string/identity_accept" />
    </LinearLayout>

    <!-- ==================== REPLY PREVIEW (как в Telegram) ==================== -->
    <LinearLayout
        android:id="@+id/reply_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_glass_row"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:elevation="8dp">

        <!-- Иконка ответа -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_reply"
            android:tint="@color/accent_purple"
            tools:ignore="UseAppTint" />

        <!-- Текст превью -->
        <TextView
            android:id="@+id/reply_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/manrope"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Кнопка закрыть -->
        <ImageView
            android:id="@+id/reply_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_hint"
            tools:ignore="UseAppTint" />

    </LinearLayout>

    <!-- ПАНЕЛЬ ВВОДА -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/input_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/glass_fill_strong"
        app:cardCornerRadius="26dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/glass_stroke_strong"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/chat_btn_attach"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_attach"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/chat_input_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:background="@android:color/transparent"
                android:hint="@string/enter_a_message"
                android:inputType="textMultiLine"
                android:gravity="center_vertical"
                android:maxLines="4"
                android:scrollbars="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/chat_btn_voice"
                app:layout_constraintStart_toEndOf="@id/chat_btn_attach"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="Autofill,TextFields" />

            <ImageView
                android:id="@+id/chat_btn_voice"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_mic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/chat_btn_send_message"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="5dp"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>