<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <!-- ==================== ПОЛУЧЕННОЕ ИЗОБРАЖЕНИЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_received_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1C1C1E"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="#6C51F7"
        app:strokeWidth="1.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/chat_received_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Время полученного -->
    <TextView
        android:id="@+id/chat_received_image_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/bloc_received_image"
        app:layout_constraintTop_toBottomOf="@id/bloc_received_image"
        android:layout_marginTop="5dp" />

    <!-- ==================== ОТПРАВЛЕННОЕ ИЗОБРАЖЕНИЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_user_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#6C51F7"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/chat_user_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Время отправленного -->
    <TextView
        android:id="@+id/chat_user_image_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/bloc_user_image"
        app:layout_constraintTop_toBottomOf="@id/bloc_user_image"
        android:layout_marginTop="5dp" />

</androidx.constraintlayout.widget.ConstraintLayout>