<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- ==================== ИСХОДЯЩЕЕ ИЗОБРАЖЕНИЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_user_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_fill"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardPreventCornerOverlap="false"
        app:strokeColor="@color/glass_stroke_strong"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <!-- Превью ответа -->
            <TextView
                android:id="@+id/user_reply_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_reply_quote"
                android:fontFamily="@font/manrope"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Картинка заполняет весь пузырек с закруглениями -->
            <ImageView
                android:id="@+id/chat_user_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Время исходящего -->
    <TextView
        android:id="@+id/chat_user_image_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bloc_user_image"
        app:layout_constraintTop_toBottomOf="@id/bloc_user_image" />

    <!-- ==================== ВХОДЯЩЕЕ ИЗОБРАЖЕНИЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_received_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_fill"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardPreventCornerOverlap="false"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <!-- Превью ответа -->
            <TextView
                android:id="@+id/received_reply_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/bg_reply_quote"
                android:fontFamily="@font/manrope"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Картинка заполняет весь пузырек с закруглениями -->
            <ImageView
                android:id="@+id/chat_received_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Время входящего -->
    <TextView
        android:id="@+id/chat_received_image_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/bloc_received_image"
        app:layout_constraintTop_toBottomOf="@id/bloc_received_image" />

</androidx.constraintlayout.widget.ConstraintLayout>
