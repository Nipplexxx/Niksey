<?xml version="1.0" encoding="utf-8"?>
<!-- Профиль собеседника: стеклянный лист с аватаром, именем, ID и статусом -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_glass"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Аватар со свечением -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/bg_avatar_glow" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_photo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:civ_border_color="@color/accent_cyan"
            app:civ_border_width="2dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/profile_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/accent_cyan"
        android:textSize="15sp" />

    <!-- ID и статус -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/profile_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_row"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_glass_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <View
                android:id="@+id/profile_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/profile_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Сведения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            style="@style/NikseyCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_me" />

        <TextView
            android:id="@+id/profile_bio"
            style="@style/NikseyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/glass_stroke" />

        <TextView
            style="@style/NikseyCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_number" />

        <TextView
            android:id="@+id/profile_phone"
            style="@style/NikseyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_copy_id"
        style="@style/NikseyButtonGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/profile_copy_id" />

</LinearLayout>
