<?xml version="1.0" encoding="utf-8"?>
<!-- Стеклянная строка контакта для выбора участников группы -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/row_fill"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke_strong"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Аватар со свечением; замок и отметка выбора — поверх аватара -->
        <FrameLayout
            android:id="@+id/add_contacts_avatar_frame"
            android:layout_width="68dp"
            android:layout_height="68dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_avatar_glow" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/add_contacts_item_photo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:civ_border_color="@color/accent_purple"
                app:civ_border_width="1.5dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_lock_encrypted"
                android:tint="@color/accent_cyan"
                tools:ignore="ContentDescription" />

            <!-- Отметка выбора -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/add_contacts_item_choice"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_ghost_check"
                android:visibility="invisible" />

        </FrameLayout>

        <!-- Имя -->
        <TextView
            android:id="@+id/add_contacts_item_name"
            style="@style/NikseyBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:maxLines="1"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/add_contacts_avatar_frame"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/example_contact_name" />

        <!-- Последнее сообщение -->
        <TextView
            android:id="@+id/add_contacts_last_message"
            style="@style/NikseySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/add_contacts_avatar_frame"
            app:layout_constraintTop_toBottomOf="@id/add_contacts_item_name"
            tools:text="@string/example_last_message" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
