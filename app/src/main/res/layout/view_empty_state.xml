<?xml version="1.0" encoding="utf-8"?>
<!-- Стеклянная заглушка пустого списка чатов -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="40dp"
    android:paddingBottom="80dp">

    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/bg_avatar_glow" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/glass_card_bg"
            app:cardCornerRadius="38dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat"
                android:tint="@color/accent_cyan"
                android:contentDescription="@null" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <TextView
        android:id="@+id/empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:text="@string/empty_chats_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/empty_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/empty_chats_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
