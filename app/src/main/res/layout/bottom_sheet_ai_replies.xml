<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ghost_card_bg"
    android:padding="24dp"
    android:elevation="16dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:text="Быстрые ответы"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/purple_300"
        android:letterSpacing="0.1"
        android:paddingBottom="20dp" />

    <!-- Ответ 1 -->
    <TextView
        android:id="@+id/reply_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:text="Спасибо!"
        android:textSize="17sp"
        android:textColor="@color/white_100"
        android:padding="16dp"
        android:background="@drawable/bg_reply_item"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical" />

    <!-- Ответ 2 -->
    <TextView
        android:id="@+id/reply_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:text="Хорошо, понял"
        android:textSize="17sp"
        android:textColor="@color/white_100"
        android:padding="16dp"
        android:background="@drawable/bg_reply_item"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical" />

    <!-- Ответ 3 -->
    <TextView
        android:id="@+id/reply_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:text="Напишу позже"
        android:textSize="17sp"
        android:textColor="@color/white_100"
        android:padding="16dp"
        android:background="@drawable/bg_reply_item"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical" />

    <!-- Ответ 4 -->
    <TextView
        android:id="@+id/reply_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:text="Позвони мне"
        android:textSize="17sp"
        android:textColor="@color/white_100"
        android:padding="16dp"
        android:background="@drawable/bg_reply_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical" />

</LinearLayout>