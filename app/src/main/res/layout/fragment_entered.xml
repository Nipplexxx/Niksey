<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/login_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ghost_card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:strokeColor="@color/purple_300"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chivo"
                android:text="VOID LOGIN"
                android:textColor="@color/white_100"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chivo"
                android:text="Анонимно • Зашифровано • Без слежки"
                android:textColor="@color/black_10"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp" />

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_input_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/purple_300"
                app:hintTextColor="@color/black_10"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white_100" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Кнопка Войти по Email -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/email_sign_in_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Войти по Email"
                android:textSize="17sp"
                app:backgroundTint="@color/purple_300"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/email_input_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Кнопка Войти по телефону -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/phone_sign_in_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Войти по номеру телефона"
                android:textSize="16sp"
                app:backgroundTint="@color/black_80"
                app:strokeColor="@color/purple_300"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/email_sign_in_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Анонимный вход -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/anonymous_sign_in_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Войти анонимно"
                android:textSize="16sp"
                app:backgroundTint="@color/black_80"
                app:strokeColor="@color/purple_300"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/phone_sign_in_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Google -->
            <com.google.android.gms.common.SignInButton
                android:id="@+id/sign_in_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/anonymous_sign_in_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>