<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Логотип / название -->
    <TextView
        android:id="@+id/entered_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.15"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/entered_subtitle"
        style="@style/NikseySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.04"
        android:text="@string/messenger_of_absolute_anonymity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/entered_title" />

    <!-- Стеклянная карточка входа -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/entered_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="@color/glass_fill"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/entered_subtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Email -->
            <EditText
                android:id="@+id/email_edit_text"
                style="@style/NikseyInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_glass"
                android:hint="@string/email"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                tools:ignore="Autofill,TextFields" />

            <!-- Основное действие: вход по email -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/email_sign_in_button"
                style="@style/NikseyButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sign_in_with_email" />

            <!-- Анонимный вход -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/anonymous_sign_in_button"
                style="@style/NikseyButtonGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/anonymous_sign_in" />

            <!-- Google -->
            <com.google.android.gms.common.SignInButton
                android:id="@+id/sign_in_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Телефон -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/phone_sign_in_button"
                style="@style/NikseyButtonGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sign_in_with_phone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
