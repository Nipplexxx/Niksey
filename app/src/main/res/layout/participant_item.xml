<?xml version="1.0" encoding="utf-8"?>
<!-- Стеклянная строка участника группы: аватар, имя (+ бейдж «создатель»), удаление -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/row_fill"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke_strong"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <!-- Аватар со свечением -->
        <FrameLayout
            android:id="@+id/participant_avatar_frame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_avatar_glow" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/participant_photo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:civ_border_color="@color/accent_purple"
                app:civ_border_width="1.5dp" />

        </FrameLayout>

        <!-- Имя -->
        <TextView
            android:id="@+id/participant_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_remove_participant"
            app:layout_constraintStart_toEndOf="@id/participant_avatar_frame"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Yura Petrov" />

        <!-- Бейдж «создатель» -->
        <TextView
            android:id="@+id/participant_creator_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_chip"
            android:fontFamily="@font/outfit"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/group_creator_badge"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/participant_name"
            app:layout_constraintStart_toEndOf="@id/participant_name"
            app:layout_constraintTop_toTopOf="@id/participant_name"
            tools:visibility="visible" />

        <!-- Удалить участника -->
        <ImageView
            android:id="@+id/btn_remove_participant"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_remove"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/error"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
