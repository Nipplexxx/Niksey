<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- ==================== ИСХОДЯЩЕЕ ВИДЕО ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_user_video"
        android:layout_width="180dp"
        android:layout_height="180dp"
        style="@style/GlassCard"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="90dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/accent_purple"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <!-- Превью -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/chat_user_video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- ExoPlayer -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/user_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <!-- Play кнопка -->
            <ImageView
                android:id="@+id/chat_user_video_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_purple" />

            <!-- Длительность -->
            <TextView
                android:id="@+id/chat_user_video_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="#B3000000"
                android:fontFamily="@font/chivo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white_100"
                android:textSize="11sp" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/chat_user_video_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bloc_user_video"
        app:layout_constraintTop_toBottomOf="@id/bloc_user_video" />

    <!-- ==================== ВХОДЯЩЕЕ ВИДЕО ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_received_video"
        android:layout_width="180dp"
        android:layout_height="180dp"
        style="@style/GlassCard"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="90dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/chat_received_video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/received_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/chat_received_video_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_blue" />

            <TextView
                android:id="@+id/chat_received_video_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="#B3000000"
                android:fontFamily="@font/chivo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white_100"
                android:textSize="11sp" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/chat_received_video_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/bloc_received_video"
        app:layout_constraintTop_toBottomOf="@id/bloc_received_video" />

</androidx.constraintlayout.widget.ConstraintLayout>