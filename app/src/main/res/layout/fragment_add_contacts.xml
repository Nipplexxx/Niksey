<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_backdrop"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Заголовок -->
    <TextView
        style="@style/NikseyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_contacts" />

    <!-- Список контактов для выбора участников -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/add_contacts_recycle_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none" />

    <!-- Кнопка «Далее» -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_contacts_btn_next"
        style="@style/NikseyButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/next" />

</LinearLayout>
