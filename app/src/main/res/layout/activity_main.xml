<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows: контент всегда под строкой состояния и над панелью навигации -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <!-- Туманные световые пятна на фоне -->
    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-140dp"
        android:layout_marginTop="-120dp"
        android:background="@drawable/bg_glow_purple" />

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-120dp"
        android:layout_marginBottom="-100dp"
        android:background="@drawable/bg_glow_cyan" />

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Стеклянная панель заголовка -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_glass_bar"
            android:elevation="0dp"
            android:paddingHorizontal="4dp"
            app:titleMarginStart="12dp"
            app:titleTextAppearance="@style/NikseyToolbarTitle"
            app:titleTextColor="@color/text_primary" />

        <FrameLayout
            android:id="@+id/data_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Плавающая стеклянная панель вкладок: Чаты · Контакты · Аккаунт -->
    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_glass_nav"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/nav_tab_chats"
            style="@style/NikseyNavTab">

            <LinearLayout style="@style/NikseyNavTabContent">
                <ImageView
                    style="@style/NikseyNavIcon"
                    android:src="@drawable/ic_chat"
                    android:contentDescription="@string/chats" />
                <TextView
                    style="@style/NikseyNavLabel"
                    android:text="@string/chats" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_tab_contacts"
            style="@style/NikseyNavTab">

            <LinearLayout style="@style/NikseyNavTabContent">
                <ImageView
                    style="@style/NikseyNavIcon"
                    android:src="@drawable/ic_group"
                    android:contentDescription="@string/contacts" />
                <TextView
                    style="@style/NikseyNavLabel"
                    android:text="@string/contacts" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_tab_account"
            style="@style/NikseyNavTab">

            <LinearLayout style="@style/NikseyNavTabContent">
                <ImageView
                    style="@style/NikseyNavIcon"
                    android:src="@drawable/ic_person"
                    android:contentDescription="@string/personal_account" />
                <TextView
                    style="@style/NikseyNavLabel"
                    android:text="@string/personal_account" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
