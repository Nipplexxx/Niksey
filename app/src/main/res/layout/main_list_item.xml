<?xml version="1.0" encoding="utf-8"?>
<!-- Стеклянная строка чата: аватар со свечением, имя, превью последнего сообщения, время -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/row_fill"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke_strong"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Аватар со мягким свечением -->
        <FrameLayout
            android:id="@+id/main_list_avatar_frame"
            android:layout_width="68dp"
            android:layout_height="68dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_avatar_glow" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/main_list_item_photo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:civ_border_color="@color/accent_cyan"
                app:civ_border_width="1.5dp" />

        </FrameLayout>

        <!-- Имя -->
        <TextView
            android:id="@+id/main_list_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/main_list_time"
            app:layout_constraintStart_toEndOf="@id/main_list_avatar_frame"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="ghost_niksey" />

        <!-- Превью последнего сообщения -->
        <TextView
            android:id="@+id/main_list_last_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/main_list_avatar_frame"
            app:layout_constraintTop_toBottomOf="@id/main_list_item_name"
            tools:text="Последний эхо • 3 мин назад" />

        <!-- Время -->
        <TextView
            android:id="@+id/main_list_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/main_list_item_name"
            tools:text="14:28" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
