<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/GlassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Аватарка -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/main_list_item_photo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_person"
            app:civ_border_width="2.5dp"
            app:civ_border_color="@color/accent_purple"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Имя -->
        <TextView
            android:id="@+id/main_list_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/chivo"
            android:textColor="@color/text_primary"
            android:textSize="16.5sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/main_list_item_photo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/main_list_time"
            tools:text="ghost_niksey" />

        <!-- Последнее сообщение -->
        <TextView
            android:id="@+id/main_list_last_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/chivo"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            app:layout_constraintStart_toEndOf="@id/main_list_item_photo"
            app:layout_constraintTop_toBottomOf="@id/main_list_item_name"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Последний эхо • 3 мин назад" />

        <!-- Время -->
        <TextView
            android:id="@+id/main_list_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/chivo"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="14:28" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>