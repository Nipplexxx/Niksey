<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="6dp">

    <!-- ==================== ПОЛУЧЕННОЕ ГОЛОСОВОЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_received_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1C1C1E"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:strokeColor="#6C51F7"
        app:strokeWidth="1.2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/chat_received_voice_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neon_orb"
                android:padding="12dp"
                android:src="@drawable/ic_play_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Волна -->
            <LinearLayout
                android:id="@+id/received_waveform"
                android:layout_width="150dp"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@id/chat_received_voice_play"
                app:layout_constraintTop_toTopOf="@id/chat_received_voice_play"
                android:layout_marginStart="14dp">

                <View android:id="@+id/received_bar1" android:layout_width="3dp" android:layout_height="6dp" android:background="#6C51F7" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/received_bar2" android:layout_width="3dp" android:layout_height="12dp" android:background="#6C51F7" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/received_bar3" android:layout_width="3dp" android:layout_height="20dp" android:background="#6C51F7" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/received_bar4" android:layout_width="3dp" android:layout_height="14dp" android:background="#6C51F7" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/received_bar5" android:layout_width="3dp" android:layout_height="24dp" android:background="#6C51F7" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/received_bar6" android:layout_width="3dp" android:layout_height="10dp" android:background="#6C51F7"/>
            </LinearLayout>

            <!-- Длительность -->
            <TextView
                android:id="@+id/chat_received_voice_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="10.5sp"
                android:fontFamily="@font/chivo"
                app:layout_constraintStart_toEndOf="@id/received_waveform"
                app:layout_constraintTop_toTopOf="@id/received_waveform"
                android:layout_marginStart="8dp" />

            <!-- SeekBar -->
            <SeekBar
                android:id="@+id/chat_received_voice_seekbar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:progressTint="#6C51F7"
                android:thumbTint="#6C51F7"
                app:layout_constraintStart_toEndOf="@id/chat_received_voice_play"
                app:layout_constraintTop_toBottomOf="@id/received_waveform"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Время полученного (точно как в тексте) -->
    <TextView
        android:id="@+id/chat_received_voice_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/bloc_received_voice"
        app:layout_constraintTop_toBottomOf="@id/bloc_received_voice"
        android:layout_marginTop="4dp" />

    <!-- ==================== ОТПРАВЛЕННОЕ ГОЛОСОВОЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_user_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#6C51F7"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/chat_user_voice_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_neon_orb_white"
                android:padding="12dp"
                android:src="@drawable/ic_play_blue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Волна -->
            <LinearLayout
                android:id="@+id/user_waveform"
                android:layout_width="150dp"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@id/chat_user_voice_play"
                app:layout_constraintTop_toTopOf="@id/chat_user_voice_play"
                android:layout_marginStart="14dp">

                <View android:id="@+id/user_bar1" android:layout_width="3dp" android:layout_height="6dp" android:background="#FFFFFF" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/user_bar2" android:layout_width="3dp" android:layout_height="12dp" android:background="#FFFFFF" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/user_bar3" android:layout_width="3dp" android:layout_height="20dp" android:background="#FFFFFF" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/user_bar4" android:layout_width="3dp" android:layout_height="14dp" android:background="#FFFFFF" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/user_bar5" android:layout_width="3dp" android:layout_height="24dp" android:background="#FFFFFF" android:layout_marginEnd="2.5dp"/>
                <View android:id="@+id/user_bar6" android:layout_width="3dp" android:layout_height="10dp" android:background="#FFFFFF"/>
            </LinearLayout>

            <!-- Длительность -->
            <TextView
                android:id="@+id/chat_user_voice_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:textSize="10.5sp"
                android:fontFamily="@font/chivo"
                app:layout_constraintStart_toEndOf="@id/user_waveform"
                app:layout_constraintTop_toTopOf="@id/user_waveform"
                android:layout_marginStart="8dp" />

            <!-- SeekBar -->
            <SeekBar
                android:id="@+id/chat_user_voice_seekbar"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF"
                app:layout_constraintStart_toEndOf="@id/chat_user_voice_play"
                app:layout_constraintTop_toBottomOf="@id/user_waveform"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Время отправленного (точно как в тексте) -->
    <TextView
        android:id="@+id/chat_user_voice_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/bloc_user_voice"
        app:layout_constraintTop_toBottomOf="@id/bloc_user_voice"
        android:layout_marginTop="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>