<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ui.screens.other_fragment.splash_screen">

    <!-- Glassmorphic центр -->
    <com.google.android.material.card.MaterialCardView
        style="@style/GlassCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="20dp"
        app:strokeColor="@color/accent_purple"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="48dp"
            android:gravity="center">

            <!-- Favicon -->
            <ImageView
                android:id="@+id/ivFavicon"
                android:layout_width="180dp"
                android:layout_height="194dp"
                android:contentDescription="@string/todo"
                app:srcCompat="@drawable/favicon" />

            <!-- VOID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chivo"
                android:text="@string/brand_name"
                android:textColor="@color/accent_purple"
                android:textSize="52sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginTop="24dp" />

            <!-- Подзаголовок -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chivo"
                android:text="@string/splash_subtitle"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Неоновый индикатор внизу -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/end_to_end_encrypted"
        android:textColor="@color/accent_purple"
        android:textSize="12sp"
        android:letterSpacing="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>