<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true"
    tools:context=".ui.screens.other_fragment.splash_screen">

    <!-- Стеклянный центр -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        app:cardBackgroundColor="@color/glass_fill"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:strokeColor="@color/glass_stroke_strong"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="48dp"
            android:gravity="center">

            <!-- Favicon -->
            <ImageView
                android:id="@+id/ivFavicon"
                android:layout_width="180dp"
                android:layout_height="194dp"
                android:contentDescription="@string/todo"
                app:srcCompat="@drawable/favicon" />

            <!-- Название бренда -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="@string/brand_name"
                android:textColor="@color/accent_purple"
                android:textSize="52sp"
                android:letterSpacing="0.15"
                android:layout_marginTop="24dp" />

            <!-- Подзаголовок -->
            <TextView
                style="@style/NikseySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_subtitle"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Подпись шифрования внизу -->
    <TextView
        style="@style/NikseyCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/end_to_end_encrypted"
        android:textColor="@color/accent_cyan"
        android:letterSpacing="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
