<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_backdrop"
    android:padding="20dp">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/create_group_title"
        style="@style/NikseyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_new_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Стеклянная карточка: аватар группы и количество участников -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/create_group_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/create_group_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp">

            <!-- Аватар со свечением -->
            <FrameLayout
                android:layout_width="124dp"
                android:layout_height="124dp">

                <View
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:background="@drawable/bg_avatar_glow" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/create_group_photo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_group"
                    app:civ_border_color="@color/accent_cyan"
                    app:civ_border_width="2dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/create_group_counts"
                style="@style/NikseySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Название группы -->
    <EditText
        android:id="@+id/create_group_input_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_glass"
        android:fontFamily="@font/manrope"
        android:hint="@string/enter_a_name"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/create_group_card"
        tools:ignore="Autofill,TextFields" />

    <!-- Список участников -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/create_group_recycle_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/create_group_input_name" />

    <!-- Кнопка создания: главное действие -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/create_group_btn_complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:backgroundTint="@color/bubble_out_start"
        app:elevation="10dp"
        app:tint="@color/white_100"
        android:src="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
