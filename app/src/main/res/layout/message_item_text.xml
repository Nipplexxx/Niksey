<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- ==================== ИСХОДЯЩЕЕ СООБЩЕНИЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        app:cardBackgroundColor="#2A1F3D"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="#6B4EFF"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Превью ответа (для исходящего) -->
            <TextView
                android:id="@+id/user_reply_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="#1A000000"
                android:fontFamily="@font/chivo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_user_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chivo"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                tools:text="Всё отлично, а у тебя?" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/chat_user_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/bloc_user_message"
        app:layout_constraintTop_toBottomOf="@id/bloc_user_message" />

    <!-- ==================== ВХОДЯЩЕЕ СООБЩЕНИЕ ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloc_received_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        app:cardBackgroundColor="@color/glass_card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Превью ответа (для входящего) -->
            <TextView
                android:id="@+id/received_reply_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="#1A000000"
                android:fontFamily="@font/chivo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chat_received_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/chivo"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                tools:text="Привет, как дела?" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/chat_received_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/chivo"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/bloc_received_message"
        app:layout_constraintTop_toBottomOf="@id/bloc_received_message" />

</androidx.constraintlayout.widget.ConstraintLayout>