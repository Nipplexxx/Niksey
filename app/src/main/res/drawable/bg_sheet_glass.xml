<?xml version="1.0" encoding="utf-8"?>
<!-- Стеклянный лист профиля: тёмное стекло, верхний блик, тонкая кромка -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@color/glass_highlight_end" />
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
        </shape>
    </item>
</layer-list>
