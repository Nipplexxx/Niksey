<?xml version="1.0" encoding="utf-8"?>
<!-- Стекло: заливка, верхний блик, внутреннее свечение снизу, тонкая кромка -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@color/glass_highlight_end" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/glass_inner_glow"
                android:endColor="@color/glow_transparent" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
