<?xml version="1.0" encoding="utf-8"?>
<!-- Входящее: тёмное матовое стекло -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bubble_in_fill" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/bubble_in_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@color/glass_highlight_end" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
